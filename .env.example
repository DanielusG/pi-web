# Pi Web environment variables. Copy this file to .env and adjust values.
# Next.js loads .env automatically on dev/server start.

# ── File editing ──────────────────────────────────────────────────────────
# Enable manual file editing in the FileViewer (Edit button + PATCH /api/files).
# Off by default. Set to "1", "true", or "yes" to enable.
NEXT_PUBLIC_PI_WEB_FILE_EDITING=0

# ── Access control ────────────────────────────────────────────────────────
# Protect the web UI with HTTP Basic Auth. Leave password empty to disable.
# Username defaults to "pi" if unset.
# PI_WEB_USERNAME=pi
# PI_WEB_PASSWORD=

# Comma-separated list of hostnames allowed to access the API (CORS/host check).
# Defaults to localhost and the configured PI_WEB_HOSTNAME.
# PI_WEB_HOSTNAME=localhost
# PI_WEB_ALLOWED_HOSTS=example.com,api.example.com
